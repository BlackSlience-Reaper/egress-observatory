{
  "manifest_version": 3,
  "name": "Egress 自动网页查询",
  "version": "1.3.3",
  "description": "读取 18 个 IP 来源；等待手动人机验证，通过后自动补充结果；逐源报告失败原因并清理临时标签。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs", "scripting", "tabGroups"],
  "host_permissions": [
    "https://ipsuper.com/*", "https://iphub.info/*", "https://www.ipqualityscore.com/*", "https://scamalytics.com/*",
    "https://www.ip2location.io/*", "https://viz.greynoise.io/*", "https://db-ip.com/*",
    "https://ipregistry.co/*", "https://blackbox.ipinfo.app/*", "https://api.ipquery.io/*",
    "https://ipinfo.io/*", "https://ipdata.co/*", "https://www.abuseipdb.com/*", "https://proxycheck.io/*",
    "http://ip-api.com/*", "https://api.ipapi.is/*", "https://www.iplocate.io/*", "https://json.geoiplookup.io/*"
  ],
  "background": {"service_worker": "background.js", "type": "module"},
  "content_scripts": [{
    "matches": ["https://blackslience-reaper.github.io/egress-observatory/*", "http://127.0.0.1:4187/*", "http://localhost:4187/*"],
    "js": ["bridge.js"],
    "run_at": "document_idle"
  }],
  "minimum_chrome_version": "120"
}
